# ===================================================
# OdontoGest - Variáveis de Ambiente (.env.example)
# ===================================================

# Conexão com o banco de dados MySQL via Prisma ORM
# Formato: mysql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL="mysql://root:senha@localhost:3306/almoxarifado_saude_db"

# Porta do servidor Fastify (API)
PORT=3001

# Ambiente de execução (development | production)
NODE_ENV=development

# Chave secreta para assinatura de cookies e sessão (OWASP)
COOKIE_SECRET="super-secret-key-pbs-saude-owasp-2026"

# Depuração do Prisma (opcional: true para exibir queries SQL no console)
DEBUG_PRISMA=false
