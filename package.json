{
  "name": "odontogest",
  "version": "2.0.0",
  "description": "Sistema de Pedidos de Bens e Serviços (PBS) - React + TypeScript + Fastify (Prisma ORM + MySQL)",
  "main": "dist/server/server.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsx watch src/server/server.ts\"",
    "db:migrate": "tsx scripts/db-cli.ts migrate deploy",
    "postinstall": "prisma generate",
    "build": "tsc && vite build && tsx scripts/compress-assets.ts",
    "start": "tsx src/server/server.ts",
    "start:local": "tsx scripts/serve-local.ts",
    "serve": "tsx src/server/server.ts",
    "prisma:generate": "prisma generate",
    "prisma:db-push": "tsx scripts/db-cli.ts db push",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "tsx scripts/test-integration.ts",
    "test:frontend": "tsx scripts/test-integration.ts --frontend",
    "test:upgrade": "tsx scripts/test-upgrade.ts",
    "db:check-upgrade": "tsx scripts/check-upgrade.ts",
    "db:backup-local": "tsx scripts/backup-local.ts",
    "db:secure-local": "tsx scripts/secure-local.ts"
  },
  "keywords": [
    "almoxarifado",
    "saude",
    "usf",
    "pbs",
    "pedidos",
    "react",
    "fastify",
    "typescript",
    "owasp",
    "oauth",
    "prisma",
    "mysql"
  ],
  "author": "Antigravity AI",
  "license": "MIT",
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/csrf-protection": "^7.0.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.4",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@prisma/client": "^6.3.0",
    "fastify": "^5.12.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "prisma": "^6.3.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  }
}
