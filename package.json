{
  "name": "odontogest",
  "version": "2.0.0",
  "description": "Sistema de Pedidos de Bens e Serviços (PBS) - React + TypeScript + Fastify (Prisma ORM + MySQL)",
  "main": "dist/server/server.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsx watch src/server/server.ts\"",
    "dev:lan": "concurrently \"vite --host\" \"tsx watch src/server/server.ts --lan\"",
    "db:migrate": "prisma migrate deploy || (prisma migrate resolve --applied 0_init && prisma migrate deploy)",
    "build": "prisma generate && (npm run db:migrate || node -e \"console.log('Aviso: migracao de banco diferida')\") && tsc && vite build",
    "start": "tsx src/server/server.ts",
    "serve": "tsx src/server/server.ts",
    "prisma:generate": "prisma generate",
    "prisma:db-push": "prisma db push"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "almoxarifado",
    "saude",
    "usf",
    "pbs",
    "pedidos",
    "react",
    "fastify",
    "typescript",
    "owasp",
    "oauth",
    "prisma",
    "mysql"
  ],
  "author": "Antigravity AI",
  "license": "MIT",
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/csrf-protection": "^7.0.2",
    "@fastify/static": "^8.0.3",
    "@prisma/client": "^6.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fastify": "^5.2.0",
    "lucide-react": "^1.61.0",
    "prisma": "^6.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@types/node": "^22.10.10",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.1.2",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  }
}
